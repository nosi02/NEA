</column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Sales" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="50"/><column index="2" value="74"/><column index="3" value="67"/><column index="4" value="93"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Sales_data" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="96"/><column index="2" value="132"/><column index="3" value="300"/><column index="4" value="68"/><column index="5" value="45"/><column index="6" value="40"/><column index="7" value="66"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Suppliers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="76"/><column index="2" value="109"/><column index="3" value="95"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- 1. Convert all dates with slashes (D/M/Y) to standardized YYYY-MM-DD
UPDATE Sales
SET SaleDate = (
    SELECT 
        -- Reconstruct as YYYY-MM-DD
        (CASE WHEN year &lt; 100 THEN '20' || printf('%02d', year) ELSE printf('%04d', year) END) || '-' || 
        printf('%02d', month) || '-' || 
        printf('%02d', day)
    FROM (
        SELECT 
            -- Extract Day
            CAST(substr(SaleDate, 1, instr(SaleDate, '/') - 1) AS INT) AS day,
            -- Extract Month
            CAST(substr(
                substr(SaleDate, instr(SaleDate, '/') + 1), 
                1, 
                instr(substr(SaleDate, instr(SaleDate, '/') + 1), '/') - 1
            ) AS INT) AS month,
            -- Extract Year
            CAST(substr(
                substr(SaleDate, instr(SaleDate, '/') + 1), 
                instr(substr(SaleDate, instr(SaleDate, '/') + 1), '/') + 1
            ) AS INT) AS year
    )
)
WHERE SaleDate LIKE '%/%';</sql><current_tab id="0"/></tab_sql></sqlb_project>
